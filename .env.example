# Copy to .env.local. Nothing here is required: with no keys and no local
# model, the agent runs on rules (the no-AI baseline).

# Which models run the agent: local | private-hybrid | mixed | haiku | rules
AGENT_PROFILE=local

# Local model (Gemma 4 12B through Ollama or LM Studio). Free, private, offline.
#   Ollama:    ollama pull gemma4:12b   → http://localhost:11434/v1
#   LM Studio: load the model, start the server → http://localhost:1234/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=gemma4:12b
# LOCAL_API=ollama        # Ollama's own API (auto-detected on port 11434); "openai" for LM Studio etc.
# LOCAL_THINK=on          # let Gemma think before answering (much slower; off by default)
# LOCAL_KEEP_ALIVE=30m    # how long Ollama keeps the model loaded between runs
# LOCAL_TIMEOUT_MS=180000
# Faster on a laptop, less accurate: LOCAL_MODEL=gemma4:e4b

# Cloud models (pay per token, from prepaid API credits; a Claude chat subscription doesn't cover API use)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Override one task's model, e.g. send only the reasoning step to Sonnet:
# AGENT_ROUTE_find_two_readings=sonnet-5.5
